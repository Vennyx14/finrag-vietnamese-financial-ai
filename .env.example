# FinRAG local settings. Copy this file to .env and put the keys there.
# .env is gitignored: never commit it or paste its content anywhere.
# Format: one variable per line, no spaces around the equals sign, no quotes,
# no comment after a value. Only FinRAG's scripts read the file
# (scripts/check_llm_key.py today, src/nlp/llm.py from plan step P2); it is not
# loaded into the shell.
#
# Base URLs and model IDs were checked against each provider's documentation on
# 2026-11-08. gpt-oss-120b is offered by all three providers, so switching
# provider keeps the planner model, and it is a different model family from the
# Claude model that prefilled the silver labels (AGENTS.md section 7).

# Provider used by the LLM layer: cerebras, openrouter or groq. A failed call is
# reported as "LLM không khả dụng"; there is no automatic switch to another
# provider (principle 18).
FINRAG_LLM_PROVIDER=groq

# Cerebras (optional; a payment method is needed for a one-time $5 credit that
# expires 30 days after activation). Key: https://cloud.cerebras.ai, API Keys.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter (optional; this model is paid there). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Groq (default; has a Free plan; blocks some networks). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
